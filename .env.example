APP_TITLE=Trading SaaS Analytics Platform
MARKET_PROVIDER=auto
# Optional: keep blank to use the no-key Yahoo Finance cloud fallback.
REALMARKET_API_KEY=
REALMARKET_API_BASE=https://api.realmarketapi.com
DEFAULT_SYMBOL=XAU/USD
DEFAULT_INTERVAL=30min
ALLOW_DEMO=false
# For production auth/database, use a persistent PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:///./trading_saas.db
SECRET_KEY=replace-with-a-long-random-secret
# Optional AI and email settings:
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Multi-provider AI failover network
GROQ_QWEN_MODEL=qwen/qwen3.6-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AI_FALLBACK_ORDER=groq,gemini,openrouter,groq_qwen,mistral,cerebras,cloudflare,deepseek,openai
