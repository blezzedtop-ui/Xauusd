# =========================
# SignalX production environment
# =========================
# REQUIRED
ADMIN_LOGIN=your-admin-login
ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password
SECRET_KEY=generate-a-long-random-secret-and-keep-it-stable
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Runtime
APP_TITLE=SignalX
SESSION_HOURS=168
DEFAULT_SYMBOL=XAU/USD
DEFAULT_INTERVAL=5min
MARKET_PROVIDER=auto
MARKET_FALLBACK_ORDER=tradingview,realmarketapi,twelvedata,yahoo
TRADINGVIEW_SYMBOL=OANDA:XAUUSD
TRADINGVIEW_BARS=500
TRADINGVIEW_TIMEOUT=5
ENABLE_API_DOCS=false
FRONTEND_ORIGINS=https://your-signalx-domain.example

# AI router
AI_PROVIDER=auto
AI_ROUTER_MODE=order
AI_PAID_FALLBACK_ENABLED=true
AI_FALLBACK_ORDER=groq,groq_2,gemini,cerebras,mistral,cloudflare,huggingface,openrouter,deepseek,anthropic,anthropic_2,anthropic_3,openai
AI_CACHE_TTL=86400
AI_FAILURE_CACHE_TTL=20
AI_PROVIDER_COOLDOWN_SECONDS=15
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY_2=
GROQ_MODEL_2=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
MISTRAL_API_KEY=
MISTRAL_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen3-32B
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5
ANTHROPIC_MODEL_2=claude-opus-5
ANTHROPIC_MODEL_3=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# MT5 gateway
MT5_BRIDGE_TOKEN=
MT5_AUTO_TRADING=false
MT5_DEFAULT_LOT=0.01
AUTOTRADE_WORKER_SECONDS=15
AUTOTRADE_INTERNAL_TOKEN=

# Optional market-data keys
REALMARKET_API_KEY=
REALMARKET_API_BASE=https://api.realmarketapi.com
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
TRADING_ECONOMICS_API_KEY=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
REQUIRE_EMAIL_DELIVERY=false

# Market Gate: broker-session aware signal/AI/AutoTrade shutdown
MARKET_GATE_ENABLED=true
MARKET_GATE_USE_MT5_SESSION=true
MARKET_GATE_MT5_STATE_MAX_AGE=20
MARKET_GATE_TZ=Asia/Tashkent
MARKET_GATE_DAILY_BREAK_ENABLED=true
MARKET_GATE_DAILY_BREAK_START=02:00
MARKET_GATE_DAILY_BREAK_END=03:00
MARKET_GATE_FALLBACK_WEEKEND_ENABLED=true

# Token-saving AI validation policy
AI_VALIDATION_ONCE_PER_CANDLE=true
AI_PREVALIDATION_MIN_CONFIDENCE=70
AI_PREVALIDATION_MIN_RR=1.50
AI_MAX_CONSENSUS_EVENTS_PER_CYCLE=6
AI_FAILURE_CACHE_TTL=300
AI_PROVIDER_COOLDOWN_SECONDS=15
